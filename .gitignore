# Dependencias
node_modules/

# Variables de entorno (nunca subir al repo)
.env
.env.local

# Archivos subidos por usuarios
public/uploads/garajes/*
public/uploads/perfiles/*
!public/uploads/garajes/.gitkeep
!public/uploads/perfiles/.gitkeep

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# Editor y herramientas locales
.vscode/
.claude/

# Librerías de terceros locales
AdminLTE-master/

# Documentación / manuales / herramientas (no forman parte del código del proyecto)
docs/
tools/
/*.pdf
/*.docx
~$*.docx
~$*.doc

# Archivos temporales sueltos
Ctmp_test.txt
guia_extraida.txt
